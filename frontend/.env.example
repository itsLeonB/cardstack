VITE_API_BASE_URL=http://localhost:8080

# Public origin of the deployed frontend, no trailing slash. Used for the
# og:image URL, sitemap.xml and the robots.txt Sitemap line; each is skipped
# when this is unset.
VITE_SITE_URL=http://localhost:3000

# Public origin of the image host that serves hosted card and set images
# (the API's IMAGE_BASE_URL, ADR-0016), no trailing slash. Image addresses on
# this host are resized and converted at read time; leave it unset locally and
# addresses are used as the API returns them.
VITE_IMAGE_HOST=

# Clerk publishable key (public). From scripts/clerk-setup.sh; development
# instance locally, production instance on Vercel production only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# End-to-end sign-in test user in the Clerk development instance.
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=change-me
