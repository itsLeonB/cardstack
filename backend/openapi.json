{
  "components": {
    "schemas": {
      "AddEntryInputBody": {
        "additionalProperties": false,
        "properties": {
          "cardId": {
            "description": "The Card to add.",
            "type": "string"
          },
          "quantity": {
            "description": "Number of copies.",
            "format": "int64",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "cardId",
          "quantity"
        ],
        "type": "object"
      },
      "AuthMessage": {
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "CardSummary": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "expansionSet": {
            "$ref": "#/components/schemas/ExpansionSetSummary"
          },
          "id": {
            "type": "string"
          },
          "illustrator": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "localId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rarity": {
            "$ref": "#/components/schemas/RaritySummary"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "expansionSet",
          "localId",
          "name",
          "category",
          "tags",
          "rarity",
          "illustrator",
          "imageUrl"
        ],
        "type": "object"
      },
      "CollectionBody": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "description": "Optional free-text description.",
            "type": "string"
          },
          "maxCardCount": {
            "description": "Hard cap on the Collection's summed card quantity; 0 means no limit.",
            "format": "int64",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "The Collection's title.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "CollectionSummary": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "maxCardCount": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "maxCardCount"
        ],
        "type": "object"
      },
      "EnvelopeAuthMessage": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AuthMessage"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeCollectionSummary": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CollectionSummary"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeHealthStatus": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeInventoryEntry": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/InventoryEntry"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeListCollectionSummary": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/CollectionSummary"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeListInventoryItem": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/InventoryItem"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeListRaritySummary": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/RaritySummary"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeListString": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeMeResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MeResponse"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeSeriesBrowseResult": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SeriesBrowseResult"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EnvelopeWithMetaListCardSummaryPaginationMeta": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/CardSummary"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ExpansionSetSummary": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "releaseDate": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "InventoryEntry": {
        "additionalProperties": false,
        "properties": {
          "cardId": {
            "type": "string"
          },
          "quantity": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "cardId",
          "quantity"
        ],
        "type": "object"
      },
      "InventoryItem": {
        "additionalProperties": false,
        "properties": {
          "card": {
            "$ref": "#/components/schemas/CardSummary"
          },
          "quantity": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "card",
          "quantity"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MeResponse": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "type": "object"
      },
      "PaginationMeta": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "page": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "page",
          "limit"
        ],
        "type": "object"
      },
      "RaritySummary": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ],
        "type": "object"
      },
      "RegisterInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "passwordConfirmation": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "passwordConfirmation"
        ],
        "type": "object"
      },
      "SeriesBrowseResult": {
        "additionalProperties": false,
        "properties": {
          "series": {
            "items": {
              "$ref": "#/components/schemas/SeriesSummary"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "ungroupedExpansionSets": {
            "items": {
              "$ref": "#/components/schemas/ExpansionSetSummary"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "series",
          "ungroupedExpansionSets"
        ],
        "type": "object"
      },
      "SeriesSummary": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "expansionSets": {
            "items": {
              "$ref": "#/components/schemas/ExpansionSetSummary"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "expansionSets"
        ],
        "type": "object"
      },
      "UpdateEntryInputBody": {
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "description": "New number of copies.",
            "format": "int64",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "quantity"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "CookieAuth": {
        "in": "cookie",
        "name": "access_token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Cardstack API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeAuthMessage"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Log in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "CookieAuth": []
          }
        ],
        "summary": "Log out and clear the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "get-current-user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeMeResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "CookieAuth": []
          }
        ],
        "summary": "Get the current session's user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh-token",
        "parameters": [
          {
            "in": "cookie",
            "name": "refresh_token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeAuthMessage"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Rotate the refresh token and issue a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeAuthMessage"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Register with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/catalog/cards": {
      "get": {
        "operationId": "search-catalog-cards",
        "parameters": [
          {
            "description": "Case-insensitive substring match on the Card's name.",
            "explode": false,
            "in": "query",
            "name": "name",
            "schema": {
              "description": "Case-insensitive substring match on the Card's name.",
              "type": "string"
            }
          },
          {
            "description": "Only Cards in this Expansion Set.",
            "explode": false,
            "in": "query",
            "name": "expansionSetId",
            "schema": {
              "description": "Only Cards in this Expansion Set.",
              "type": "string"
            }
          },
          {
            "description": "Only the Card with this number within its Expansion Set (e.g. \"001\"), typically combined with expansionSetId.",
            "explode": false,
            "in": "query",
            "name": "localId",
            "schema": {
              "description": "Only the Card with this number within its Expansion Set (e.g. \"001\"), typically combined with expansionSetId.",
              "type": "string"
            }
          },
          {
            "description": "Only Cards with this Rarity.",
            "explode": false,
            "in": "query",
            "name": "rarityId",
            "schema": {
              "description": "Only Cards with this Rarity.",
              "type": "string"
            }
          },
          {
            "description": "Only Cards with this exact category (e.g. Pokémon, Trainer, Energi).",
            "explode": false,
            "in": "query",
            "name": "category",
            "schema": {
              "description": "Only Cards with this exact category (e.g. Pokémon, Trainer, Energi).",
              "type": "string"
            }
          },
          {
            "description": "Only Cards carrying this tag.",
            "explode": false,
            "in": "query",
            "name": "tag",
            "schema": {
              "description": "Only Cards carrying this tag.",
              "type": "string"
            }
          },
          {
            "description": "1-indexed page number.",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "1-indexed page number.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Page size.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 24,
              "description": "Page size.",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeWithMetaListCardSummaryPaginationMeta"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Search/browse Cards by name, Expansion Set + card number, rarity, category, and tag",
        "tags": [
          "catalog"
        ]
      }
    },
    "/catalog/categories": {
      "get": {
        "operationId": "list-catalog-categories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeListString"
                }
              }
            },
            "description": "OK",
            "headers": {
              "X-Total-Count": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the distinct Card categories in use, for use as a search filter value",
        "tags": [
          "catalog"
        ]
      }
    },
    "/catalog/rarities": {
      "get": {
        "operationId": "list-catalog-rarities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeListRaritySummary"
                }
              }
            },
            "description": "OK",
            "headers": {
              "X-Total-Count": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List every Rarity, for use as a search filter value",
        "tags": [
          "catalog"
        ]
      }
    },
    "/catalog/series": {
      "get": {
        "operationId": "list-catalog-series",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeSeriesBrowseResult"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List every Series (with its Expansion Sets nested) plus every ungrouped Expansion Set",
        "tags": [
          "catalog"
        ]
      }
    },
    "/catalog/tags": {
      "get": {
        "operationId": "list-catalog-tags",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeListString"
                }
              }
            },
            "description": "OK",
            "headers": {
              "X-Total-Count": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
