# App
APP_CLIENT_URLS=http://localhost:3000
APP_ENV=debug
APP_PORT=8080
APP_TIMEOUT=10s
# Cloudflare edge secret. Leave unset locally and in previews (no Cloudflare there).
APP_EDGE_SECRET=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=cardstack
DB_PASSWORD=cardstack
DB_NAME=cardstack
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cardstack

# Auth
AUTH_JWT_SECRET=change-me-to-a-long-random-value
AUTH_JWT_ISSUER=cardstack
AUTH_JWT_DURATION=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
# None: frontend (Vercel) and backend (Railway) are cross-site in prod, and
# SameSite=Lax cookies are excluded from cross-site fetch/XHR entirely.
AUTH_COOKIE_SAMESITE=None

# Clerk
CLERK_SECRET_KEY=sk_test_xxx

# Image hosting (docs/adr/0016). IMAGE_BASE_URL is the public address of the
# image host; the API serves it plus the hosted key. The R2_* values are only
# read by the ingester and are optional: unset, it logs a warning and hosts
# nothing. R2_ENDPOINT overrides https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
IMAGE_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
