# App
APP_CLIENT_URLS=http://localhost:3000
APP_ENV=debug
APP_PORT=8080
APP_TIMEOUT=10s
# Cloudflare edge secret. Leave unset locally and in previews (no Cloudflare there).
APP_EDGE_SECRET=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=cardstack
DB_PASSWORD=cardstack
DB_NAME=cardstack
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cardstack

# Clerk: the only identity system (docs/adr/0015). The API verifies Clerk
# session tokens and holds no credentials, sessions or cookies.
# CLERK_SECRET_KEY fetches the instance's signing keys. CLERK_ISSUER is the
# instance's Frontend API URL (the iss claim of its tokens): the Clerk
# dashboard's Frontend API URL, or the base64 payload of the publishable key.
# Tokens must also come from one of APP_CLIENT_URLS (their authorized party),
# compared as exact strings: each entry is a bare origin such as
# https://www.example.com, with no trailing slash, path or spaces.
# The API refuses to boot without the first two or with a malformed
# APP_CLIENT_URLS entry; with no APP_CLIENT_URLS it boots but rejects every
# token.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_ISSUER=https://example.clerk.accounts.dev

# Image hosting (docs/adr/0016). IMAGE_BASE_URL is the public address of the
# image host; the API serves it plus the hosted key. The R2_* values are only
# read by the ingester and are optional: unset, it logs a warning and hosts
# nothing. R2_ENDPOINT overrides https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
IMAGE_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Card embeddings (cmd/embed-catalog and cmd/collect-embeddings) and the scan
# match (POST /scan/match, which embeds each uploaded photo). Use a paid Gemini
# key: the batch jobs need billing, and on the free tier Google may use what is
# sent, including users' photos, to improve its products. The API boots without
# GEMINI_API_KEY but logs an error and fails every scan match.
# EMBEDDING_MODEL names the model whose embeddings are stored and searched;
# changing it makes every card eligible for re-embedding.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2

# When the scan match calls its top candidate confident (cosine similarity, 0 to
# 1): the top score must reach MATCH_THRESHOLD and the runner-up must trail it
# by at least MATCH_MARGIN. The API refuses to boot outside 0 < threshold <= 1
# or 0 <= margin < 1. Provisional until ticket 07 measures them on the full
# catalog.
MATCH_THRESHOLD=0.85
MATCH_MARGIN=0.03

# Per-user rate limits for signed-in callers: a token bucket per user per tier,
# refilling PER_MINUTE tokens a minute up to BURST. Search covers the
# name-searchable card lists (catalog, inventory, collection entries), facets
# the three facets routes; neither spends the general USER tier. In
# memory, so a deploy resets them and they only hold on a single replica.
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_USER_BURST=100
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_SEARCH_BURST=30
RATE_LIMIT_FACETS_PER_MINUTE=30
RATE_LIMIT_FACETS_BURST=15
