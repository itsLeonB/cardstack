# Base address of the API, no trailing slash. Required for a production build
# (tools/api-address.ts); locally the Admin app falls back to localhost:8080.
VITE_API_BASE_URL=http://localhost:8080

# Clerk publishable key (public). The same instance as the user app: the
# development instance locally, the production instance on Vercel production
# only. Required for a production build (tools/clerk-key.ts).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
