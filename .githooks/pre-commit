#!/usr/bin/env bash
# Pre-commit: the checks fast enough to run on every commit, so a red CI job
# minutes later is not the first sign of a broken change (docs/git.md). They run
# in the compose stack's tooling containers through the same scripts CI calls,
# so a commit can only pass what CI passes. Tests and e2e stay with CI: they
# need the database and minutes.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

# Nothing staged: a merge, a rebase or an empty commit.
git diff --cached --quiet && exit 0

# The compose CLI alone is not enough: without a daemon every exec below fails
# with a connection error, which reads as a broken change rather than a skip.
if ! docker compose version >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo "pre-commit: docker compose or the daemon is unavailable, skipping the checks" >&2
  exit 0
fi

# --no-renames: a rename reports only its new path, which would leave the old
# path's package unchecked.
staged=$(git diff --cached --name-only --no-renames)

# shortcut: the checks read the working tree the stack bind-mounts, not a
# snapshot of the index, so unstaged edits ride along; upgrade to a snapshot
# the day a commit passes on content it does not contain.
failed=0

# Each check on its own: one failing check must not hide the others.
run() {
  "$@" && return 0
  echo "pre-commit: FAILED: $*" >&2
  failed=1
  return 0
}

# CI's `paths:` filters fire on the shared infrastructure too, so a change to it
# has to run both components' checks here or it commits unchecked and then
# changes what CI runs. It raises a flag rather than running its own block, so a
# path that also matches a component prefix never runs that component twice.
# -x: $staged is one path per line, and matching the whole variable would only
# fire when a single path was staged.
shared=0
if grep -qxE 'compose\.yaml|compose\.defaults\.env|scripts/verification/.+|\.githooks/.+' <<<"$staged"; then
  shared=1
fi

if [ "$shared" = 1 ] || [[ $staged == *backend/* ]]; then
  for step in format vet lint; do
    run scripts/verification/backend.sh "$step"
  done
fi

# Only the packages with staged files: the Admin app is untouched by most work.
for pkg in frontend admin; do
  # The tooling image at frontend/tooling.Dockerfile builds both packages, so
  # CI's Admin workflow fires on it although the path sits under frontend/.
  if [ "$shared" = 1 ] || [[ $staged == *"$pkg"/* ]] || [[ $pkg == admin && $staged == *frontend/tooling.Dockerfile ]]; then
    for step in lint format typecheck; do
      run scripts/verification/frontend.sh --package "$pkg" "$step"
    done
  fi
done

exit "$failed"
